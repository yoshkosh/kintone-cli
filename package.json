{
  "name": "@yoshkosh/kintone-cli",
  "version": "0.5.5",
  "description": "kintone REST API CLI tool",
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "kintone-cli": "./dist/index.js",
    "kt": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && npm run build:spec",
    "build:spec": "node scripts/build-spec.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "npm run build:spec && vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "kintone",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yoshkosh/kintone-cli.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.18.0",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3",
    "undici": "^8.1.0",
    "vitest": "^4.1.4",
    "yaml": "^2.8.3"
  }
}
