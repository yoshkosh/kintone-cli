{
  "name": "@yoshkosh/kintone-cli",
  "version": "0.6.0",
  "description": "Schema-validated kintone REST API CLI for humans and AI agents",
  "type": "module",
  "files": [
    "dist",
    "skills",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "kintone-cli": "./dist/index.js",
    "kt": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/build-spec.mjs",
    "build:spec": "node scripts/build-spec.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "node scripts/build-spec.mjs && vitest run",
    "test:watch": "vitest",
    "prepack": "tsc && node scripts/build-spec.mjs"
  },
  "keywords": [
    "kintone",
    "cli",
    "rest-api",
    "ai-agent",
    "agent-skills",
    "claude-code",
    "openapi",
    "openapi-spec",
    "validation"
  ],
  "author": {
    "name": "Isao Yoshikoshi",
    "url": "https://github.com/yoshkosh"
  },
  "homepage": "https://github.com/yoshkosh/kintone-cli#readme",
  "bugs": {
    "url": "https://github.com/yoshkosh/kintone-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoshkosh/kintone-cli.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.20.0",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.18.0",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3",
    "undici": "^8.1.0",
    "vitest": "^4.1.4",
    "yaml": "^2.8.3"
  }
}
